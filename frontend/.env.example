# Firebase Web Configuration for Krishi Sakhi
# Obtain these credentials from the Firebase Console (Project Settings > General > Your apps > Web app)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend API URL (Default: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Admin Credentials (Set your credentials here locally; .env is gitignored and will never be pushed to GitHub)
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=your_secure_admin_password_here
